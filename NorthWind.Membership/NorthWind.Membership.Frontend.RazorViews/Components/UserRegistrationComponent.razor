<EditForm Model=ViewModel OnValidSubmit=ViewModel.Register> 
    <ModelValidator Validator="ViewModel.Validator" 
                    @ref=ViewModel.ModelValidatorComponentReference /> 
    <ValidationSummary/> 
    <div class="form-group"> 
        <label for="FirstName"> 
            @UserRegistrationMessages.FirstNameLabel 
        </label> 
        <InputText id="FirstName" 
                   class="form-control" 
                   placeholder="@UserRegistrationMessages.FirstNameLabel" 
                   maxlength="30"
                   autocomplete="off"
                   onkeydown="if(event.key.length === 1 && !/[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]/.test(event.key) && !event.ctrlKey && !event.metaKey) { event.preventDefault(); return false; }"
                   oninput="this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]/g, '').slice(0, 30);"
                   @bind-Value=ViewModel.FirstName /> 
        <ValidationMessage For="@(() => ViewModel.FirstName)" /> 
    </div> 
    <div class="form-group"> 
        <label for="LastName"> 
            @UserRegistrationMessages.LastNameLabel 
        </label> 
        <InputText id="LastName" 
                   class="form-control" 
                   placeholder="@UserRegistrationMessages.LastNameLabel" 
                   maxlength="30"
                   autocomplete="off"
                   onkeydown="if(event.key.length === 1 && !/[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]/.test(event.key) && !event.ctrlKey && !event.metaKey) { event.preventDefault(); return false; }"
                   oninput="this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]/g, '').slice(0, 30);"
                   @bind-Value=ViewModel.LastName /> 
        <ValidationMessage For="@(() => ViewModel.LastName)" /> 
    </div> 
    <div class="form-group"> 
        <label for="Email"> 
            @CommonMessages.EmailLabel 
        </label> 
        <InputText id="Email" 
                   class="form-control" 
                   placeholder="@CommonMessages.EmailLabel" 
                   maxlength="100"
                   autocomplete="off"
                   onkeydown="if(event.key.length === 1 && !event.ctrlKey && !event.metaKey) { if(!/^[a-zA-Z0-9._\-\x40]$/.test(event.key) || (event.key === '\x40' && this.value.includes('\x40'))) { event.preventDefault(); return false; } }"
                   oninput="let v = this.value.replace(/[^a-zA-Z0-9._\-\x40]/g, ''); const at = v.indexOf('\x40'); if(at !== -1) { v = v.slice(0, at + 1) + v.slice(at + 1).replace(/\x40/g, ''); } this.value = v.slice(0, 100);"
                   @bind-Value=ViewModel.Email /> 
        <ValidationMessage For="@(() => ViewModel.Email)" /> 
    </div> 
    <div class="form-group"> 
        <label for="Password"> 
            @CommonMessages.PasswordLabel 
        </label> 
        <InputText id="Password" 
                   class="form-control" 
                   placeholder="@CommonMessages.PasswordLabel" 
                   type="password" 
                   @bind-Value=ViewModel.Password /> 
        <ValidationMessage For="@(() => ViewModel.Password)" /> 
    </div> 
    <div class="form-group"> 
        <label for="PasswordConfirmation"> 
            @UserRegistrationMessages.PasswordConfirmationLabel 
        </label> 
        <InputText id="PasswordConfirmation" 
                   class="form-control" 
                   placeholder="@UserRegistrationMessages.PasswordConfirmationLabel" 
                   type="password" 
                   @bind-Value=ViewModel.PasswordConfirmation /> 
        <ValidationMessage For="@(() => ViewModel.PasswordConfirmation)" /> 
    </div> 
    <div class="row p-3"> 
        <div class="col"> 
            <button class="btn btn-primary"> 
                @UserRegistrationMessages.RegisterButtonText 
            </button> 
        </div> 
    </div> 
</EditForm> 
<hr /> 
@if (!string.IsNullOrWhiteSpace(ViewModel.InformationMessage)) 
{ 
    <div class="alert alert-info"> 
        @ViewModel.InformationMessage 
    </div> 
}
