@using NorthWind.Sales.Entities.Dtos.Invoices
@using Microsoft.JSInterop
@inject IJSRuntime JS

@if (Invoice != null)
{
    @if (IsVisible)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.6);">
            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content shadow-lg border-0">
                    <div class="modal-header bg-dark text-white no-print">
                        <h5 class="modal-title">
                            <i class="bi bi-file-earmark-pdf-fill text-danger me-2"></i>
                            Factura de Venta #@Invoice.Id - Vista Previa y PDF
                        </h5>
                        <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body p-4 bg-light">
                        <!-- Printable Invoice Card -->
                        <div id="printable-invoice" class="card border shadow-sm bg-white mx-auto" style="max-width: 720px; width: 100%; padding: 20px 22px; box-sizing: border-box;">
                            @RenderInvoiceDetails()
                        </div>
                    </div>
                    <div class="modal-footer bg-light no-print d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">
                            Cerrar
                        </button>
                        <div>
                            <button type="button" class="btn btn-success btn-lg shadow-sm" @onclick="DownloadPdf">
                                📥 Exportar PDF
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Contenedor invisible para exportación directa sin alterar el flujo visual ni recortar el pie -->
        <div style="position: absolute; left: 0; top: 0; width: 720px; opacity: 0; pointer-events: none; z-index: -99999;">
            <div id="printable-invoice" class="card border-0 bg-white" style="width: 720px; max-width: 720px; padding: 20px 22px; box-sizing: border-box;">
                @RenderInvoiceDetails()
            </div>
        </div>
    }

    <!-- Print styling for clean export -->
    <style>
        #printable-invoice {
            box-sizing: border-box !important;
            padding: 20px 22px !important;
            background-color: #ffffff !important;
            width: 720px !important;
            max-width: 720px !important;
        }
        #printable-invoice .row {
            margin-left: 0 !important;
            margin-right: 0 !important;
        }
        #printable-invoice .table-responsive {
            overflow: visible !important;
            padding: 0 !important;
            margin-bottom: 1rem !important;
        }
        #printable-invoice .table {
            width: 100% !important;
            margin-bottom: 0 !important;
            table-layout: auto !important;
        }
        #printable-invoice .table th,
        #printable-invoice .table td {
            padding: 6px 8px !important;
        }
        @@media print {
            body * {
                visibility: hidden;
            }
            #printable-invoice, #printable-invoice * {
                visibility: visible;
            }
            #printable-invoice {
                position: absolute;
                left: 0;
                top: 0;
                width: 100% !important;
                max-width: 100% !important;
                box-shadow: none !important;
                border: none !important;
                padding: 15px 20px !important;
                margin: 0 !important;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
}

@code {
    [Parameter]
    public OrderInvoiceDto? Invoice { get; set; }

    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task CloseModal()
    {
        await OnClose.InvokeAsync();
    }

    private async Task DownloadPdf()
    {
        if (Invoice != null)
        {
            string filename = $"Factura_Orden_{Invoice.Id:D8}.pdf";
            await JS.InvokeVoidAsync("downloadInvoicePdf", "printable-invoice", filename);
        }
    }

    private RenderFragment RenderInvoiceDetails() => __builder =>
    {
        if (Invoice == null) return;

        <!-- Header / Company Info -->
        <div class="row align-items-center border-bottom pb-3 mb-3 border-dark">
            <div class="col-7">
                <h3 class="text-dark fw-bold mb-0">NORTHWIND STORE</h3>
                <div class="text-secondary small">Facturación Electrónica</div>
                <div class="text-secondary small">R.U.C.: 1891723456001</div>
                <div class="text-secondary small">Dirección: Av. Los Chasquis y Río Guayllabamba, Ambato - Ecuador</div>
                <div class="text-secondary small">Email: facturacion@northwind.com | Tel: (03) 2851894</div>
            </div>
            <div class="col-5 text-end">
                <div class="border border-2 border-dark rounded p-2 text-center bg-light">
                    <h5 class="fw-bold mb-1 text-dark">FACTURA DE VENTA</h5>
                    <div class="fs-5 fw-bold text-dark">N° @Invoice.Id.ToString("D8")</div>
                    <div class="small text-muted">Fecha: @Invoice.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>
        </div>

        <!-- Customer Details (Maestro) -->
        <div class="card bg-light border border-secondary mb-3 p-3">
            <div class="row g-2 small text-dark">
                <div class="col-6">
                    <strong>Cliente / Razón Social:</strong>
                    <span class="ms-1">@Invoice.CustomerName</span>
                </div>
                <div class="col-6">
                    <strong>Cédula / RUC:</strong>
                    <span class="ms-1 fw-bold">@Invoice.CustomerId</span>
                </div>
                <div class="col-6">
                    <strong>Dirección de Entrega:</strong>
                    <span class="ms-1">@Invoice.ShipAddress, @Invoice.ShipCity</span>
                </div>
                <div class="col-6">
                    <strong>País / C. Postal:</strong>
                    <span class="ms-1">@Invoice.ShipCountry (@Invoice.ShipPostalCode)</span>
                </div>
            </div>
        </div>

        <!-- Order Products Table (Detalle) -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle mb-0 border-dark">
                <thead class="table-dark text-center">
                    <tr>
                        <th style="width: 40px;">#</th>
                        <th class="text-start ps-2">Descripción del Artículo</th>
                        <th style="width: 70px;">Cant.</th>
                        <th style="width: 110px;" class="text-end pe-2">Precio Unit. ($)</th>
                        <th style="width: 115px;" class="text-end pe-2">Subtotal ($)</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Invoice.Details.Count; i++)
                    {
                        var item = Invoice.Details[i];
                        <tr>
                            <td class="text-center text-dark fw-bold">@(i + 1)</td>
                            <td class="text-start ps-2 text-dark">@item.ProductName</td>
                            <td class="text-center fw-bold text-dark">@item.Quantity</td>
                            <td class="text-end pe-2 text-dark">$ @item.UnitPrice.ToString("N2")</td>
                            <td class="text-end pe-2 fw-bold text-dark">$ @item.Subtotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Financial Summary -->
        <div class="row justify-content-end">
            <div class="col-6 col-sm-5 pe-2">
                <table class="table table-sm table-bordered mb-0 border-dark">
                    <tbody>
                        <tr>
                            <th class="bg-light text-dark ps-2">Subtotal:</th>
                            <td class="text-end fw-bold pe-2 text-dark">$ @Invoice.Subtotal.ToString("N2")</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-dark ps-2">IVA (15%):</th>
                            <td class="text-end fw-bold text-dark pe-2">$ @Invoice.Tax.ToString("N2")</td>
                        </tr>
                        <tr class="table-light border-top border-dark border-2">
                            <th class="fs-6 fw-bold ps-2 text-dark">TOTAL A PAGAR:</th>
                            <td class="text-end fs-5 fw-bolder text-dark pe-2">$ @Invoice.Total.ToString("N2")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Footer notes -->
        <div class="border-top border-dark pt-3 text-center text-dark small mt-2">
            <p class="mb-0">Gracias por su compra. Documento emitido por el Sistema NorthWind.</p>
        </div>
    };
}
