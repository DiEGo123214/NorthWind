    private OrderInvoiceDto? InvoiceToExport = null;
    private bool IsAutoDownloadingPdf = false;
    private CancellationTokenSource? _autoDismissCts;

    private async Task HandleOrderSubmit()
    {
        _autoDismissCts?.Cancel();
        _autoDismissCts?.Dispose();
        _autoDismissCts = null;

        await Order.Send();

        if (Order.LastCreatedOrderId.HasValue)
        {
            var createdOrderId = Order.LastCreatedOrderId.Value;
            _ = AutoDownloadInvoicePdfAsync(createdOrderId);
            StartAutoDismissTimer();
        }
    }

    private async Task AutoDownloadInvoicePdfAsync(int orderId)
    {
        try
        {
            IsAutoDownloadingPdf = true;
            await InvokeAsync(StateHasChanged);

            InvoiceToExport = await InvoiceGateway.GetOrderInvoiceAsync(orderId);
            if (InvoiceToExport != null)
            {
                await InvokeAsync(StateHasChanged);
                await Task.Delay(700); // Dar tiempo para que el DOM y los datos se monten completamente
                string filename = $"Factura_Orden_{InvoiceToExport.Id:D8}.pdf";
                await JS.InvokeVoidAsync("downloadInvoicePdf", "printable-invoice", filename);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al exportar factura automática: {ex.Message}");
        }
        finally
        {
            IsAutoDownloadingPdf = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StartAutoDismissTimer()
    {
        _autoDismissCts?.Cancel();
        _autoDismissCts?.Dispose();
        _autoDismissCts = new CancellationTokenSource();
        var token = _autoDismissCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(5000, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(() =>
                    {
                        DismissSuccessAlert();
                    });
                }
            }
            catch (TaskCanceledException)
            {
                // Temporizador cancelado normalmente
            }
        });
    }

    private void DismissSuccessAlert()
    {
        _autoDismissCts?.Cancel();
        _autoDismissCts?.Dispose();
        _autoDismissCts = null;
        Order.ClearMessages();
        StateHasChanged();
    }

    public void Dispose()
    {
        _autoDismissCts?.Cancel();
        _autoDismissCts?.Dispose();
    }
}
