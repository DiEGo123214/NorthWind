@using NorthWind.Sales.Entities.Dtos.Customers
@using NorthWind.Sales.Entities.Dtos.Invoices
@using NorthWind.Sales.Entities.Dtos.Products
@using NorthWind.Sales.Frontend.Views.ViewModels.CreateOrder
@using Microsoft.JSInterop
@implements IDisposable

@inject NorthWind.Sales.Frontend.BusinessObjects.Interfaces.ISearchCustomersGateway SearchGateway
@inject NorthWind.Sales.Frontend.BusinessObjects.Interfaces.IOrderInvoiceGateway InvoiceGateway
@inject IJSRuntime JS

<EditForm Model="Order" OnValidSubmit="HandleOrderSubmit">
    <ModelValidator Validator="Order.Validator"
                    @ref=Order.ModelValidatorComponentReference />
    <ValidationSummary class="alert alert-danger" />

    <!-- Invoice Header / Customer Information -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-receipt"></i> @CreateOrderMessages.CreateOrderPageTitle
            </h5>
            <span class="badge bg-light text-primary fs-6">Punto de Venta</span>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <!-- Selector / Búsqueda de Cliente -->
                <div class="col-12 col-md-7">
                    <label class="form-label fw-bold" for="customerId">
                        @(Order.SelectedCustomer != null ? "Cliente seleccionado " : "Seleccionar cliente ")
                    </label>
                    <div class="input-group">
                        <input type="text" class="form-control bg-light" id="customerId" 
                               placeholder="Seleccione un cliente desde la lista..." 
                               value="@(Order.SelectedCustomer != null ? Order.CustomerName : "")" 
                               disabled 
                               style="cursor: default;" />
                        <button class="btn btn-primary" type="button" @onclick="OpenCustomerModal">
                            👥 Lista de Clientes
                        </button>
                        @if (!string.IsNullOrWhiteSpace(Order.CustomerId))
                        {
                            <button class="btn btn-outline-danger" type="button" @onclick="PromptRemoveCustomer" title="Quitar cliente de la factura">
                                ✖ Quitar cliente
                            </button>
                        }
                    </div>
                    <ValidationMessage For="() => Order.CustomerId" class="text-danger small" />
                </div>

                @if (Order.SelectedCustomer != null)
                {
                    <!-- Datos Informativos Registrados del Cliente -->
                    <div class="col-12">
                        <div class="card bg-light border-primary border-opacity-25 shadow-sm">
                            <div class="card-body py-2 px-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="text-primary fw-bold small">
                                        <i class="bi bi-person-vcard-fill me-1"></i> Datos del Cliente
                                    </div>
                                    @* Botón para actualizar datos del cliente (Oculto temporalmente hasta implementar el módulo CRUD de clientes)
                                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" 
                                            @onclick="OpenEditCustomerModal" 
                                            title="Actualizar datos de ubicación del cliente en la BD">
                                        ✏️ Actualizar datos del cliente
                                    </button>
                                    *@
                                </div>
                                <div class="row g-3 small text-dark">
                                    <div class="col-12 col-sm-6 col-md-4">
                                        <span class="text-muted d-block fw-semibold">Cédula:</span>
                                        <span class="badge bg-primary text-white fs-6 px-2 py-1">@Order.CustomerId</span>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-4">
                                        <span class="text-muted d-block fw-semibold">Correo Electrónico:</span>
                                        <span class="fw-bold text-break text-dark">@(string.IsNullOrWhiteSpace(Order.CustomerEmail) ? "(No registrado)" : Order.CustomerEmail)</span>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-4">
                                        <span class="text-muted d-block fw-semibold">Dirección:</span>
                                        <span class="fw-bold text-break">@(string.IsNullOrWhiteSpace(Order.CustomerAddress) ? "(No registrada)" : Order.CustomerAddress)</span>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-4">
                                        <span class="text-muted d-block fw-semibold">Ciudad:</span>
                                        <span class="fw-bold">@(string.IsNullOrWhiteSpace(Order.CustomerCity) ? "(No registrada)" : Order.CustomerCity)</span>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-4">
                                        <span class="text-muted d-block fw-semibold">País:</span>
                                        <span class="fw-bold">@(string.IsNullOrWhiteSpace(Order.CustomerCountry) ? "(No registrado)" : Order.CustomerCountry)</span>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-4">
                                        <span class="text-muted d-block fw-semibold">Código Postal:</span>
                                        <span class="fw-bold">@(string.IsNullOrWhiteSpace(Order.CustomerPostalCode) ? "(No registrado)" : Order.CustomerPostalCode)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Botones de Opción para el Envío -->
                <div class="col-12">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 p-2 rounded bg-light border">
                        <div>
                            <span class="fw-bold text-secondary">
                                <i class="bi bi-truck me-1"></i> Dirección para el Envío:
                            </span>
                        </div>
                        <div class="btn-group" role="group" aria-label="Opciones de dirección de envío">
                            <input type="radio" class="btn-check" name="shippingOptionRadio" id="optCustomerAddress" 
                                   autocomplete="off"
                                   checked="@(Order.ShippingOption == ShippingOptionType.CustomerAddress)" 
                                   @onchange="() => SetShippingOption(ShippingOptionType.CustomerAddress)" 
                                   disabled="@(Order.SelectedCustomer == null)" />
                            <label class="btn btn-sm @(Order.ShippingOption == ShippingOptionType.CustomerAddress ? "btn-primary shadow-sm" : "btn-outline-primary")" 
                                   for="optCustomerAddress">
                                🏠 Usar mi dirección
                            </label>

                            <input type="radio" class="btn-check" name="shippingOptionRadio" id="optCustomAddress" 
                                   autocomplete="off"
                                   checked="@(Order.ShippingOption == ShippingOptionType.CustomAddress)" 
                                   @onchange="() => SetShippingOption(ShippingOptionType.CustomAddress)" 
                                   disabled="@(Order.SelectedCustomer == null)" />
                            <label class="btn btn-sm @(Order.ShippingOption == ShippingOptionType.CustomAddress ? "btn-primary shadow-sm" : "btn-outline-primary")" 
                                   for="optCustomAddress">
                                ✍️ Otra dirección
                            </label>
                        </div>
                    </div>
                    @if (Order.SelectedCustomer != null)
                    {
                        @if (Order.ShippingOption == ShippingOptionType.CustomerAddress)
                        {
                            <div class="form-text text-success small mt-1">
                                <i class="bi bi-check-circle-fill me-1"></i> Los campos de envío se llenaron automáticamente con los datos registrados del cliente.
                            </div>
                        }
                        else if (Order.ShippingOption == ShippingOptionType.CustomAddress)
                        {
                            <div class="form-text text-primary small mt-1">
                                <i class="bi bi-pencil-square me-1"></i> Campos habilitados. Ingrese una dirección de entrega para esta orden.
                            </div>
                        }
                        
                    }
                    else
                    {
                        <div class="form-text text-muted small mt-1">
                            ℹ️ Seleccione un cliente desde la lista para habilitar las opciones de dirección de envío.
                        </div>
                    }
                </div>

                <!-- Campos de Dirección de Envío -->
                <div class="col-md-6">
                    <label class="form-label fw-bold" for="shipAddress">@CreateOrderMessages.ShipAddressLabel </label>
                    <InputText class="@ShippingInputClass" 
                               id="shipAddress" 
                               placeholder="@CreateOrderMessages.ShipAddressLabel" 
                               maxlength="60" 
                               autocomplete="off"
                               disabled="@(Order.ShippingOption != ShippingOptionType.CustomAddress)"
                               style="@(Order.ShippingOption != ShippingOptionType.CustomAddress ? "cursor: not-allowed;" : "")"
                               onkeydown="if(event.key.length === 1 && !/[a-zA-Z0-9áéíóúÁÉÍÓÚñÑüÜ\s.,\-#/:°]/.test(event.key) && !event.ctrlKey && !event.metaKey) { event.preventDefault(); return false; }"
                               oninput="this.value = this.value.replace(/[^a-zA-Z0-9áéíóúÁÉÍÓÚñÑüÜ\s.,\-#/:°]/g, '').slice(0, 60);"
                               @bind-Value="Order.ShipAddress" />
                    <ValidationMessage For="() => Order.ShipAddress" class="text-danger small" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold" for="shipCity">@CreateOrderMessages.ShipCityLabel </label>
                    <InputText class="@ShippingInputClass" 
                               id="shipCity" 
                               placeholder="@CreateOrderMessages.ShipCityLabel" 
                               maxlength="15" 
                               autocomplete="off"
                               disabled="@(Order.ShippingOption != ShippingOptionType.CustomAddress)"
                               style="@(Order.ShippingOption != ShippingOptionType.CustomAddress ? "cursor: not-allowed;" : "")"
                               onkeydown="if(event.key.length === 1 && !/[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]/.test(event.key) && !event.ctrlKey && !event.metaKey) { event.preventDefault(); return false; }"
                               oninput="this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]/g, '').slice(0, 15);"
                               @bind-Value="Order.ShipCity" />
                    <ValidationMessage For="() => Order.ShipCity" class="text-danger small" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold" for="shipCountry">@CreateOrderMessages.ShipCountryLabel </label>
                    <InputText class="@ShippingInputClass" 
                               id="shipCountry" 
                               placeholder="@CreateOrderMessages.ShipCountryLabel" 
                               maxlength="15" 
                               autocomplete="off"
                               disabled="@(Order.ShippingOption != ShippingOptionType.CustomAddress)"
                               style="@(Order.ShippingOption != ShippingOptionType.CustomAddress ? "cursor: not-allowed;" : "")"
                               onkeydown="if(event.key.length === 1 && !/[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]/.test(event.key) && !event.ctrlKey && !event.metaKey) { event.preventDefault(); return false; }"
                               oninput="this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]/g, '').slice(0, 15);"
                               @bind-Value="Order.ShipCountry" />
                    <ValidationMessage For="() => Order.ShipCountry" class="text-danger small" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold" for="shipPostalCode">@CreateOrderMessages.ShipPostalCodeLabel</label>
                    <InputText class="@ShippingInputClass" 
                               id="shipPostalCode" 
                               placeholder="Ej. 180101" 
                               maxlength="6" 
                               autocomplete="off"
                               disabled="@(Order.ShippingOption != ShippingOptionType.CustomAddress)"
                               style="@(Order.ShippingOption != ShippingOptionType.CustomAddress ? "cursor: not-allowed;" : "")"
                               onkeydown="if(event.key.length === 1 && !/[0-9]/.test(event.key) && !event.ctrlKey && !event.metaKey) { event.preventDefault(); return false; }"
                               oninput="this.value = this.value.replace(/\D/g, '').slice(0, 6);"
                               @bind-Value="Order.ShipPostalCode" />
                    <ValidationMessage For="() => Order.ShipPostalCode" class="text-danger small" />
                </div>
            </div>
        </div>
    </div>

    <!-- Order Details / Products Table -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-secondary">
                Detalle de la Orden
            </h5>
            <div class="d-flex align-items-center gap-2">
                @if (Order.OrderDetails != null && Order.OrderDetails.Count > 0)
                {
                    <button type="button" class="btn btn-outline-danger btn-sm shadow-sm" @onclick="PromptCancelOrder" title="Cancelar orden y vaciar productos">
                        🚫 Cancelar Orden
                    </button>
                }
                <button type="button" class="btn btn-success btn-sm shadow-sm" @onclick="OpenAddProductModal">
                    🔍 Buscar Producto Disponible
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Order.OrderDetails == null || Order.OrderDetails.Count == 0)
            {
                <div class="p-4 text-center text-muted">
                    <p class="mb-2">No hay productos agregados a la orden de venta.</p>
                    <!--
                    <button type="button" class="btn btn-outline-success btn-sm" @onclick="OpenAddProductModal">
                        🔍 Buscar Producto Disponible
                    </button>
                    -->
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th style="width: 90px;">Código</th>
                                <th>Descripción del Producto</th>
                                <th style="width: 130px;" class="text-end">Precio ($)</th>
                                <th style="width: 140px;" class="text-center">Cantidad</th>
                                <th style="width: 140px;" class="text-end">Subtotal ($)</th>
                                <th style="width: 150px;" class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Order.OrderDetails.Count; i++)
                            {
                                var Item = Order.OrderDetails[i];
                                var index = i + 1;
                                <tr>
                                    <td class="text-muted fw-bold">@index</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@Item.ProductId</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@Item.ProductName</span>
                                        @if (Item.UnitsInStock > 0)
                                        {
                                            <span class="badge @(Item.AvailableStock > 0 ? "bg-info text-dark" : "bg-warning text-dark") ms-2"
                                                  title="Stock inicial en inventario: @Item.UnitsInStock | Cantidad en orden: @Item.Quantity">
                                                Disponible: @Item.AvailableStock (de @Item.UnitsInStock)
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        $ @Item.UnitPrice.ToString("N2")
                                    </td>
                                    <td class="text-center">
                                        <input type="number" 
                                               class="form-control form-control-sm text-center mx-auto" 
                                               style="max-width: 90px;" 
                                               min="1" 
                                               max="@Item.UnitsInStock"
                                               value="@Item.Quantity"
                                               onkeydown="if(event.key === '-' || event.key === '+' || event.key === 'e' || event.key === 'E' || event.keyCode === 189 || event.keyCode === 109) { event.preventDefault(); return false; }"
                                               onpaste="let pasteData = (event.clipboardData || window.clipboardData).getData('text'); if (!/^\d+$/.test(pasteData) || Number(pasteData) < 1) { event.preventDefault(); }"
                                               @oninput="(e) => HandleQuantityInput(Item, e)"
                                               @onchange="(e) => HandleQuantityChange(Item, e)" />
                                        @if (Item.HasStockError)
                                        {
                                            <span class="badge bg-danger small mt-1 d-block">
                                                Supera stock (@Item.UnitsInStock)
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end fw-bold text-primary">
                                        $ @Item.Subtotal.ToString("N2")
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-warning" title="Cambiar por otro producto"
                                                    @onclick="() => OpenChangeProductModal(Item)">
                                                🔄 Cambiar
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" title="Eliminar de la orden"
                                                    @onclick="() => PromptRemoveProduct(Item)">
                                                ✖
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Summary Totals and Actions -->
    <div class="row g-4 align-items-start">
        <div class="col-md-7">
            @if (Order.HasAnyStockErrors)
            {
                <div class="alert alert-danger shadow-sm" role="alert">
                    <strong>Atención:</strong> Uno o más productos superan el stock disponible en inventario. Corrija las cantidades antes de guardar la orden.
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Order.InformationMessage))
            {
                <div class="alert alert-success shadow-sm alert-dismissible fade show" role="alert">
                    <div class="d-flex align-items-center">
                        <div>
                            <strong>Éxito:</strong> @Order.InformationMessage
                            @if (IsAutoDownloadingPdf)
                            {
                                <div class="mt-1 small text-success fw-semibold">
                                    <div class="spinner-border spinner-border-sm me-1" role="status"></div>
                                    Generando y guardando factura en PDF automáticamente...
                                </div>
                            }
                        </div>
                    </div>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="DismissSuccessAlert"></button>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Order.ErrorMessage))
            {
                <div class="alert alert-danger shadow-sm d-flex align-items-center" role="alert">
                    <div>
                        <strong>Error en la transacción:</strong> @Order.ErrorMessage
                    </div>
                </div>
            }
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal:</span>
                        <span class="fw-bold">$ @Order.Subtotal.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">IVA (15%):</span>
                        <span class="fw-bold">$ @Order.Tax.ToString("N2")</span>
                    </div>
                    <hr class="my-2" />
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fs-5 fw-bold text-dark">Total a Pagar:</span>
                        <span class="fs-4 fw-bolder text-primary">$ @Order.Total.ToString("N2")</span>
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm" 
                                disabled="@(Order.HasAnyStockErrors || Order.OrderDetails.Count == 0 || string.IsNullOrWhiteSpace(Order.CustomerId))">
                            Finalizar Venta
                        </button>
                        @* Botón Cancelar Orden desactivado según requerimiento
                        @if (!string.IsNullOrWhiteSpace(Order.CustomerId) || (Order.OrderDetails != null && Order.OrderDetails.Count > 0))
                        {
                            <button type="button" class="btn btn-outline-danger shadow-sm" @onclick="PromptCancelOrder" title="Cancelar la orden actual y vaciar todos los campos">
                                🚫 Cancelar Orden
                            </button>
                        }
                        *@
                    </div>
                </div>
            </div>
        </div>
    </div>
</EditForm>

<!-- Ventanas Emergentes (Modales de Búsqueda Inteligente y Edición) -->
<CustomerSearchModal 
    IsVisible="IsCustomerModalVisible" 
    OnCustomerSelected="HandleCustomerSelected" 
    OnClose="CloseCustomerModal" />

@* Modal de edición de ubicación del cliente (Oculto temporalmente hasta implementar el módulo CRUD de clientes)
<EditCustomerLocationModal
    IsVisible="IsEditCustomerModalVisible"
    Customer="Order.SelectedCustomer"
    OnSaved="HandleCustomerLocationUpdated"
    OnClose="CloseEditCustomerModal" />
*@

<ProductSearchModal 
    IsVisible="IsProductModalVisible" 
    OnProductSelected="HandleProductSelected" 
    OnClose="CloseProductModal" 
    ExistingProductIds="ExistingProductIds" 
    SelectedQuantities="SelectedProductQuantities" />

<!-- Componente de Factura para Exportación Directa a PDF Completo sin cortes -->
<InvoiceViewerModal 
    IsVisible="false" 
    Invoice="InvoiceToExport" 
    OnClose="() => InvoiceToExport = null" />
<!-- Modal Emergente de Confirmación (Quitar cliente, Quitar producto, Cancelar orden) -->
@if (IsConfirmModalVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.55); z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-3">
                <div class="modal-header bg-danger text-white py-2 px-3">
                    <h5 class="modal-title fs-6 fw-bold d-flex align-items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-exclamation-triangle-fill" viewBox="0 0 16 16">
                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                        </svg>
                        <span>@ConfirmTitle</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="CloseConfirmModal"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <div class="mb-3">
                        <span class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle p-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="bi bi-trash3-fill" viewBox="0 0 16 16">
                                <path d="M11 1.5v1h3.5a.5.5 0 0 1 0 1h-.538l-.853 10.66A2 2 0 0 1 11.115 16h-6.23a2 2 0 0 1-1.994-1.84L2.038 3.5H1.5a.5.5 0 0 1 0-1H5v-1A1.5 1.5 0 0 1 6.5 0h3A1.5 1.5 0 0 1 11 1.5m-5 0v1h4v-1a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5M4.5 5.029l.5 8.5a.5.5 0 1 0 .998-.06l-.5-8.5a.5.5 0 1 0-.998.06m6.53-.528a.5.5 0 0 0-.528.47l-.5 8.5a.5.5 0 0 0 .998.058l.5-8.5a.5.5 0 0 0-.47-.528M8 4.5a.5.5 0 0 0-.5.5v8.5a.5.5 0 0 0 1 0V5a.5.5 0 0 0-.5-.5"/>
                            </svg>
                        </span>
                    </div>
                    <p class="fs-6 text-dark mb-1">
                        @ConfirmMessage
                    </p>
                    <div class="text-muted small">
                        ¿Desea continuar con esta acción?
                    </div>
                </div>
                <div class="modal-footer bg-light d-flex justify-content-end gap-2 py-2 px-3">
                    <button type="button" class="btn btn-secondary px-3" @onclick="CloseConfirmModal">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-danger px-3 shadow-sm" @onclick="ExecuteConfirmedAction">
                        @ConfirmButtonText
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private enum ConfirmActionType
    {
        None,
        RemoveCustomer,
        RemoveProduct,
        CancelOrder
    }

    private bool IsConfirmModalVisible = false;
    private ConfirmActionType CurrentConfirmAction = ConfirmActionType.None;
    private CreateOrderDetailViewModel? ItemToRemove = null;
    private string ConfirmTitle = string.Empty;
    private string ConfirmMessage = string.Empty;
    private string ConfirmButtonText = "Quitar";

    private bool IsCustomerModalVisible = false;
    private bool IsProductModalVisible = false;
    private bool IsEditCustomerModalVisible = false;
    private string ShippingInputClass => Order?.ShippingOption == ShippingOptionType.CustomAddress ? "form-control" : "form-control bg-light";

    private CreateOrderDetailViewModel? TargetItemToChange = null;
    private bool IsChangingExistingProduct => TargetItemToChange != null;
    private IEnumerable<int> ExistingProductIds => Order?.OrderDetails.Select(d => d.ProductId) ?? [];

    private IReadOnlyDictionary<int, int> SelectedProductQuantities =>
        Order?.OrderDetails
            .Where(d => TargetItemToChange == null || d != TargetItemToChange)
            .GroupBy(d => d.ProductId)
            .ToDictionary(g => g.Key, g => (int)g.Sum(d => d.Quantity))
        ?? new Dictionary<int, int>();

    private void PromptRemoveCustomer()
    {
        CurrentConfirmAction = ConfirmActionType.RemoveCustomer;
        ItemToRemove = null;
        ConfirmTitle = "¿Quitar cliente de la factura?";
        ConfirmMessage = $"¿Está seguro de que desea quitar al cliente {Order.CustomerName} ({Order.CustomerId}) de la factura? Se restablecerán también los datos de dirección de envío.";
        ConfirmButtonText = "Quitar";
        IsConfirmModalVisible = true;
    }

    private void PromptRemoveProduct(CreateOrderDetailViewModel item)
    {
        CurrentConfirmAction = ConfirmActionType.RemoveProduct;
        ItemToRemove = item;
        ConfirmTitle = "¿Quitar producto de la orden?";
        ConfirmMessage = $"¿Está seguro de que desea quitar el producto \"{item.ProductName}\" de la orden?";
        ConfirmButtonText = "Quitar";
        IsConfirmModalVisible = true;
    }

    private void PromptCancelOrder()
    {
        CurrentConfirmAction = ConfirmActionType.CancelOrder;
        ItemToRemove = null;
        ConfirmTitle = "¿Cancelar toda la orden de venta?";
        var count = Order.OrderDetails?.Count ?? 0;
        ConfirmMessage = $"¿Está seguro de que desea cancelar la orden? Se borrarán el cliente seleccionado y los {count} producto(s) agregados.";
        ConfirmButtonText = "Cancelar orden";
        IsConfirmModalVisible = true;
    }

    private void CloseConfirmModal()
    {
        IsConfirmModalVisible = false;
        CurrentConfirmAction = ConfirmActionType.None;
        ItemToRemove = null;
    }

    private void ExecuteConfirmedAction()
    {
        switch (CurrentConfirmAction)
        {
            case ConfirmActionType.RemoveCustomer:
                Order.ClearCustomer();
                break;
            case ConfirmActionType.RemoveProduct:
                if (ItemToRemove != null)
                {
                    Order.RemoveOrderDetailItem(ItemToRemove);
                }
                break;
            case ConfirmActionType.CancelOrder:
                Order.ResetOrder();
                break;
        }
        CloseConfirmModal();
        StateHasChanged();
    }

